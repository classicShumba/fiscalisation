<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_vat" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.vat</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Rename VAT field label -->
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="string">VAT Number</attribute>
            </xpath>
            
            <!-- Add TIN field after VAT -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="tin" string="TIN Number"/>
            </xpath>
        </field>
    </record>
</odoo>
